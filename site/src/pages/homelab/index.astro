---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('homelab', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Homelab" description="NAS, Raspberry Pi and other homelab projects.">
  <h1>Homelab</h1>
  <p class="muted">Projects running on hardware at home. Add a post by dropping a Markdown file into <code>site/src/content/homelab/</code>.</p>
  <div class="grid">
    {posts.map((p) => (
      <a class="card" href={`/homelab/${p.id}/`}>
        <h3>{p.data.title}</h3>
        <p class="muted">{p.data.summary}</p>
        <p>{p.data.tags.map((t) => <span class="tag">{t}</span>)}</p>
      </a>
    ))}
  </div>
</Base>

<style>.tag { margin-right: .3rem; }</style>
